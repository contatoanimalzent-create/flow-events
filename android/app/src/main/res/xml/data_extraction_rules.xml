<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules.
    Define o que pode/nao pode sair do dispositivo via Backup ou Device-to-Device transfer.
    Nao incluimos dados sensiveis (tokens, sessoes) nos backups.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="sharedpref" path="supabase.auth.token" />
        <exclude domain="database" path="*.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="sharedpref" path="supabase.auth.token" />
        <exclude domain="database" path="*.db" />
    </device-transfer>
</data-extraction-rules>
